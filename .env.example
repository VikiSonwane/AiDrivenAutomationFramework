# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# MCP Server Configuration
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost

# Browser Configuration
HEADLESS=true
BROWSER_TIMEOUT=30000
SLOW_MO=0

# Redis Configuration
REDIS_URL=redis://localhost:6379

# PostgreSQL Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_qa

# Test Configuration
MAX_RETRIES=3
PARALLEL_WORKERS=4
SCREENSHOT_ON_FAILURE=true

# Cost Optimization
ENABLE_PROMPT_CACHING=true
USE_CHEAP_MODEL_FOR_SIMPLE_TASKS=true
CHEAP_MODEL=claude-3-haiku-20240307
EXPENSIVE_MODEL=claude-3-5-sonnet-20240620

# Self-Healing Configuration
ENABLE_SELF_HEALING=true
AUTO_HEAL_CONFIDENCE_THRESHOLD=0.8
REQUIRE_HUMAN_APPROVAL=true

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
